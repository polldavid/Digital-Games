<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (AlagaWidget.java). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_since_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <Chronometer
            android:id="@+id/w_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_brand"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_since_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/widget_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_feed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/w_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_feed_btn"
            style="@style/AlagaWidgetButton"
            android:layout_marginEnd="6dp"
            android:text="🍼 Feed" />
        <TextView
            android:id="@+id/w_diaper"
            style="@style/AlagaWidgetButton"
            android:layout_marginEnd="6dp"
            android:text="🧷 Diaper" />
        <TextView
            android:id="@+id/w_sleep"
            style="@style/AlagaWidgetButton"
            android:text="🌙 Sleep" />
    </LinearLayout>
</LinearLayout>
